EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# advisor. (python main.py advisor-serve)
# Get a key at https://platform.claude.com (API keys page). Without a key, chat answers come from the app's data only.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
