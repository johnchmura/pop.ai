# Each chat sends a short course slice. gpt-5-mini is the default.
# OPENAI_API_KEY=
# LLM_PROVIDER=openai
# OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# MAX_TOKENS=4096
# CHAT_RATE_LIMIT=30
# PORT=3000
# HOST=127.0.0.1
# POP_DB_PATH=data/pop.db
